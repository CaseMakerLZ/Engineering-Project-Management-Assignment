# Copy this file to .env and fill in local values.
# Never commit the real .env file.

# LLM
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=200

# Network tool server-side credential (optional)
SERPAPI_API_KEY=

# Python Agent Service
AGENT_SERVICE_NAME=python-agent-service
AGENT_SERVICE_INTERNAL_TOKEN=
AGENT_SERVICE_MAX_PROMPT_LENGTH=20000

# MySQL
AGENT_SERVICE_MYSQL_HOST=127.0.0.1
AGENT_SERVICE_MYSQL_PORT=3306
AGENT_SERVICE_MYSQL_USER=root
AGENT_SERVICE_MYSQL_PASSWORD=
AGENT_SERVICE_MYSQL_DATABASE=agent_javabackend

# Local mode: bind one business project ID to one local directory.
AGENT_SERVICE_EXECUTION_MODE=local
AGENT_SERVICE_PROJECT_ID=
AGENT_SERVICE_PROJECT_ROOT=

# Cloud mode uses AGENT_SERVICE_WORKSPACE_ROOT/project_id.
AGENT_SERVICE_WORKSPACE_ROOT=.
