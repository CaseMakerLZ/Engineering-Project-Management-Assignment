<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.Agent.javabackend.Mapper.ProjectMapper">
    <resultMap id="ProjectMap" type="com.Agent.javabackend.entity.MessageContainer.Project">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="localPath" column="local_path"/>
        <result property="createdAt" column="created_at" typeHandler="com.Agent.javabackend.Config.SqliteOffsetDateTimeTypeHandler"/>
        <result property="updatedAt" column="updated_at" typeHandler="com.Agent.javabackend.Config.SqliteOffsetDateTimeTypeHandler"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO project (id, name, description, local_path, created_at, updated_at)
        VALUES (#{id}, #{name}, #{description}, #{localPath}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="findById" resultMap="ProjectMap">
        SELECT id, name, description, local_path, created_at, updated_at
        FROM project WHERE id = #{projectId}
    </select>
</mapper>
